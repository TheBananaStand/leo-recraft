{
  "name": "recraft",
  "label": "Recraft",
  "description": "Professional image generation, vectorizing and background removal — installed at runtime.",
  "icon": "palette",
  "version": "1.0.0",
  "author": "TheBananaStand",
  "homepage": "https://github.com/TheBananaStand/leo-recraft-mcp",
  "category": "package",
  "mcp": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "https://github.com/TheBananaStand/leo-recraft-mcp/archive/ba30d389360069ad7a2f193b7aaf4f394df346e8.tar.gz"
    ]
  },
  "descriptor": {
    "provides": [
      "image_gen"
    ],
    "fields": [
      {
        "key": "recraft_api_key",
        "label": "API Key",
        "field_type": "password",
        "required": true
      }
    ],
    "entitlements": {
      "settings_read": [
        "recraft_api_key"
      ],
      "network": [
        "external.api.recraft.ai"
      ],
      "sends": [
        {
          "to": "external.api.recraft.ai",
          "classes": [
            "prompts",
            "photos"
          ],
          "purpose": "The prompt you asked for an image from, and — for vectorize and background removal — the image file you pointed at. Nothing else from Leo travels with it."
        }
      ]
    }
  }
}
